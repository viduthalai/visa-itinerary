# Travelpayouts Data API token (free: register as a partner, Profile -> API token).
# Without it the flight search returns clearly-labelled sample data.
TRAVELPAYOUTS_TOKEN=

# Public origin of the deployed site, no trailing slash. Drives canonical URLs,
# sitemap.xml, robots.txt and the Open Graph image. Must be set before a real
# deploy — the code falls back to a placeholder that is only right for local dev.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
