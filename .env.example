# AeroDataBox (via RapidAPI) — PRIMARY flight provider: real scheduled flights for
# any route/date (no price; the Fare block is optional). Free "Basic" tier: 600 API
# units/month, 1 req/s. Key: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
RAPIDAPI_KEY=

# Travelpayouts Data API token — FALLBACK provider (cached cheapest fares WITH price,
# but often empty for a specific future date). Free: register as a partner, Profile ->
# API token. With neither key set, flight search returns clearly-labelled sample data.
TRAVELPAYOUTS_TOKEN=

# Flight search only calls the real providers in a production build; a dev server
# always returns labelled sample data so it never spends the small free quota on
# hot-reloads. Set FLIGHTS_LIVE=true to opt a single local run into the real
# providers when you need to verify the integration end-to-end.
FLIGHTS_LIVE=

# Public origin of the deployed site, no trailing slash. Drives canonical URLs,
# sitemap.xml, robots.txt and the Open Graph image. Must be set before a real
# deploy — the code falls back to a placeholder that is only right for local dev.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
