    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tz-lookup": "6.1.25"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
