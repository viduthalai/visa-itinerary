    "type": "git",
    "url": "git+https://github.com/viduthalai/visa-itinerary.git"
  },
  "bugs": {
    "url": "https://github.com/viduthalai/visa-itinerary/issues"
  },
  "keywords": [
    "travel-itinerary",
    "flight-itinerary",
    "itinerary-generator",
    "pdf",
    "nextjs",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
